<style>
  .result-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    background: var(--snow);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(74,53,36,0.12);
    margin-bottom: 32px;
  }
  .result-card img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; display: block; }
  .result-card-body { padding: 28px 28px 28px 0; display: flex; flex-direction: column; justify-content: center; }
  .result-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 10px 0 14px; font-family: var(--font-utility); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--timber); }
  .result-meta strong { color: var(--forest); }
  .result-placement { display:inline-block; background: var(--forest); color: var(--snow); font-family: var(--font-utility); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 6px 14px; border-radius: 20px; margin-bottom: 10px; }
  .result-card.milestone { border: 2px solid var(--gold); box-shadow: 0 6px 24px rgba(186,109,61,0.25); }
  .result-card.milestone .result-placement { background: var(--gold); color: var(--forest-deep); }
  .milestone-banner { font-family: var(--font-utility); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); text-align:center; margin-bottom: 6px; }
  .result-card.dual-photo { grid-template-columns: 420px 1fr; }
  @media (max-width: 720px) {
    .result-card { grid-template-columns: 1fr; }
    .result-card-body { padding: 20px; }
    .result-card img { min-height: 320px; }
    .result-card.dual-photo { grid-template-columns: 1fr; }
  }
</style>

